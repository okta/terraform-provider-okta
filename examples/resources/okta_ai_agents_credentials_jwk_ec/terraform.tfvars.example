# Terraform variables example for okta_ai_agents_credentials_jwk_ec

# Replace with your Okta organization name
okta_org_name = "your-okta-org"

# Leave as-is for okta.com, or use "oktapreview.com" for preview environment
okta_base_url = "okta.com"

# Your Okta API token (set via environment variable in production)
# okta_api_token = "XXXX" # Don't commit this! Use environment variable instead

# The ID of the AI Agent where you want to add the key
# Get this from your Okta dashboard: AI Agents > [Agent Name] > Agent ID
agent_id = "00u1a2b3c4d5e6f7g8h9i"

# EC public key coordinates (base64url-encoded)
# Generate these using OpenSSL or Python (see README.md)
# These are example P-256 coordinates - replace with your actual key
key_coordinates = {
  x = "WKn-ZIGevcwGIyyrzFoZNBdaq9_TsqzGl96oc0CWuis"
  y = "y77t-RvAHRKTsSGdIYUfweuOvwrvDD-Q3Hv5J0fSKcE"
}

# To use this file:
# 1. Copy this file to terraform.tfvars:
#    cp terraform.tfvars.example terraform.tfvars
#
# 2. Edit terraform.tfvars with your actual values
#
# 3. For the API token, use environment variable instead:
#    export TF_VAR_okta_api_token="your-api-token"
#    or
#    export OKTA_API_TOKEN="your-api-token"
#
# 4. Run Terraform:
#    terraform plan
#    terraform apply

# SECURITY NOTE:
# - Never commit terraform.tfvars to version control
# - Use .gitignore to exclude it:
#   echo "terraform.tfvars" >> .gitignore
#   echo "terraform.tfvars.json" >> .gitignore
#   echo ".env" >> .gitignore
#
# - Use environment variables for sensitive values:
#   export TF_VAR_okta_api_token="your-token"
#   or
#   export OKTA_API_TOKEN="your-token"
